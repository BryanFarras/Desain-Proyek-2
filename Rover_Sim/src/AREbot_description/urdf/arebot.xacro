<?xml version="1.0"?>
<robot name="arebot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${m}" />
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0"
               izz="${(m/2) * (r*r)}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${m}" />
      <inertia ixx="${(2/5) * m * r * r}" ixy="0" ixz="0"
               iyy="${(2/5) * m * r * r}" iyz="0"
               izz="${(2/5) * m * r * r}" />
    </inertial>
  </xacro:macro>

  <link name="base_footprint">
    <inertial>
      <mass value="1e-5" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6" />
    </inertial>
  </link>

  <link name="base_link" />

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_footprint" />
    <child link="base_link" />
  </joint>

  <link name="chassis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.09" length="0.20"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.09" length="0.20"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="2.0" r="0.09" h="0.20"/>
  </link>

  <joint name="chassis_joint" type="fixed">
    <origin xyz="0 0 0.12" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="chassis" />
  </joint>

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0325" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0325" length="0.04"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.2" r="0.0325" h="0.04"/>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="-0.04 0.11 0.0325" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="left_wheel" />
    <axis xyz="0 1 0" />
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0325" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0325" length="0.04"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.2" r="0.0325" h="0.04"/>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="-0.04 -0.11 0.0325" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="right_wheel" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="imu_joint" type="fixed">
  <parent link="base_link"/>
  <child link="imu_link"/>
  <origin xyz="0.0 0.0 0.25" rpy="0 0 0"/>
</joint>

<link name="imu_link">
  <visual>
    <geometry>
      <box size="0.01 0.01 0.01"/>
    </geometry>
    <material name="black">
      <color rgba="0 0 0 1"/>
    </material>
  </visual>
  <inertial>
    <mass value="0.01"/>
    <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
  </inertial>
</link>

  <link name="caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia m="0.1" r="0.025"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <origin xyz="0.055 0 0.025" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="caster" />
  </joint>

    <link name="support">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.01 0.05"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.01 0.05"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia m="0.1" r="0.025"/>
  </link>

  <joint name="support_joint" type="fixed">
    <origin xyz="-0.08 0 0.025" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="support" />
  </joint>

  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.1" r="0.03" h="0.04"/>
  </link>

<joint name="laser_joint" type="fixed">
    <origin xyz="0 0 0.24" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="laser" />
  </joint>

  <xacro:include filename="$(find AREbot_description)/urdf/arebot.gazebo" />

</robot>