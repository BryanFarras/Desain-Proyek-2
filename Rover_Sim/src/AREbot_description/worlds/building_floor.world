<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="building_floor_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode/></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Office-style floor plan. Footprint: 9 m (x) x 6 m (y). Walls: 0.1 m thick, 0.4 m tall. -->
    <!-- Central corridor (y in [-0.6, 0.6], 1.2 m wide) running east-west. -->
    <!-- Rooms: NW / N-mid / NE (north side), SW / SE (south side). -->
    <!-- Doorways are 0.8 m gaps in the walls. -->

    <!-- ===== Outer walls ===== -->
    <model name="outer_north"><static>true</static><link name="link"><pose>0 3.0 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>9.0 0.1 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>9.0 0.1 0.4</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual></link></model>
    <model name="outer_south"><static>true</static><link name="link"><pose>0 -3.0 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>9.0 0.1 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>9.0 0.1 0.4</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual></link></model>
    <model name="outer_east"><static>true</static><link name="link"><pose>4.5 0 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>0.1 6.0 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6.0 0.4</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual></link></model>
    <model name="outer_west"><static>true</static><link name="link"><pose>-4.5 0 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>0.1 6.0 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6.0 0.4</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual></link></model>

    <!-- ===== Corridor north wall (y = 0.6), doorways at x = -3.0, 0.0, 3.0 ===== -->
    <model name="cor_n_1"><static>true</static><link name="link"><pose>-3.95 0.6 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>1.1 0.1 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.1 0.1 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>
    <model name="cor_n_2"><static>true</static><link name="link"><pose>-1.5 0.6 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>2.2 0.1 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.2 0.1 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>
    <model name="cor_n_3"><static>true</static><link name="link"><pose>1.5 0.6 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>2.2 0.1 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.2 0.1 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>
    <model name="cor_n_4"><static>true</static><link name="link"><pose>3.95 0.6 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>1.1 0.1 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.1 0.1 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>

    <!-- ===== Corridor south wall (y = -0.6), doorways at x = -2.25, 2.25 ===== -->
    <model name="cor_s_1"><static>true</static><link name="link"><pose>-3.575 -0.6 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>1.85 0.1 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.85 0.1 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>
    <model name="cor_s_2"><static>true</static><link name="link"><pose>0.0 -0.6 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>3.7 0.1 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>3.7 0.1 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>
    <model name="cor_s_3"><static>true</static><link name="link"><pose>3.575 -0.6 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>1.85 0.1 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.85 0.1 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>

    <!-- ===== North room dividers (x = -1.5 and x = 1.5), doorway at y = 1.8 ===== -->
    <model name="n_div_wm1_y1"><static>true</static><link name="link"><pose>-1.5 1.0 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>0.1 0.8 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 0.8 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>
    <model name="n_div_wm1_y2"><static>true</static><link name="link"><pose>-1.5 2.6 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>0.1 0.8 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 0.8 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>
    <model name="n_div_wp1_y1"><static>true</static><link name="link"><pose>1.5 1.0 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>0.1 0.8 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 0.8 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>
    <model name="n_div_wp1_y2"><static>true</static><link name="link"><pose>1.5 2.6 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>0.1 0.8 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 0.8 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>

    <!-- ===== South room divider (x = 0), doorway at y = -1.8 ===== -->
    <model name="s_div_x0_y1"><static>true</static><link name="link"><pose>0.0 -2.6 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>0.1 0.8 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 0.8 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>
    <model name="s_div_x0_y2"><static>true</static><link name="link"><pose>0.0 -1.0 0.2 0 0 0</pose><collision name="collision"><geometry><box><size>0.1 0.8 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 0.8 0.4</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual></link></model>

    <!-- ===== Goal marker (SW room) ===== -->
    <model name="goal_marker">
      <static>true</static>
      <link name="link">
        <pose>-3.5 -2.2 0.01 0 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.0 0.8 0.0 1</ambient><diffuse>0.0 0.8 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
