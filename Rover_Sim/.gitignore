# Build artifacts (generated by colcon)
build/
install/
log/

# Accidental nested build artifacts (colcon run inside a package)
src/*/build/
src/*/install/
src/*/log/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Unused / experimental packages (kept in the tree but not part of this project)
src/beluga/
src/beluga_amcl/
src/beluga_ros/

# Developer / assistant tooling
.agents/
.claude/
skills-lock.json

# TF debug outputs (ros2 run tf2_tools view_frames)
frames_*.gv
frames_*.pdf

# Editors
.vscode/
*.swp
