[Unit]
Description=AER Dashboard - Autonomous Evacuation Rover
After=network.target
# If using ROS 2, uncomment the line below:
# After=network.target ros2-humble.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/aer-dashboard
Environment="PATH=/home/ubuntu/aer-dashboard/venv/bin:/usr/local/bin:/usr/bin:/bin"
# If using ROS 2, uncomment the line below:
# Environment="ROS_DISTRO=humble"
ExecStart=/home/ubuntu/aer-dashboard/venv/bin/python3 /home/ubuntu/aer-dashboard/main.py
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aer-dashboard

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/aer-dashboard/logs

[Install]
WantedBy=multi-user.target
